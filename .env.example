# Domínio final do site (sem barra no fim). Usado em canonical, sitemap.xml,
# robots.txt, llms.txt, Open Graph e JSON-LD.
# Na Vercel e na Netlify ele é detectado automaticamente se ficar vazio.
SITE_URL=https://www.seu-dominio.com.br

# Endpoint que recebe o formulário da Lista VIP (JSON: { nome, email, origem }).
# Ex.: Formspree (https://formspree.io/f/xxxx), Getform, webhook do Make/Zapier ou API própria.
# Se ficar vazio, o formulário funciona em modo demonstração (sem envio real).
VITE_LEAD_ENDPOINT=
